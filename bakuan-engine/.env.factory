# ── 爆创 bakuan-engine 出厂配置(win 包 2026-07-17)──
# 密钥出厂为空,由客户填写/由「连接飞书」流程自动写入。
# 全部键的含义/风险见交付文档《02-系统全参数配置对照表》。

# ── 飞书(数据中心走 lark-cli 后端;App ID/Secret 仅开放平台后端需要,可留空)──
FEISHU_BACKEND=larkcli
LARK_PROFILE=baochuang-client
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BOT_VERIFY_TOKEN=

# ── 采集通道 ──
TIKHUB_API_BASE=https://api.tikhub.io
TIKHUB_API_KEY=
DAJIALA_API_BASE=https://www.dajiala.com
DAJIALA_KEY=

# ── LLM(文本三层 + 兜底)──
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_TIER_LOW=deepseek-chat
LLM_TIER_MID=deepseek-chat
LLM_TIER_HIGH=deepseek-reasoner
LLM_FALLBACK_MODEL=deepseek-chat

# ── 火山 ARK(生图/视觉)──
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
IMAGE_MODEL=doubao-seedream-4-0-250828
VISION_MODEL=

# ── ASR(默认火山录音识别;密钥空=跳过转写用标题兜底)──
ASR_PROVIDER=volc
ASR_API_KEY=

# ── RAG / 调度 ──
RAG_TOPK=8
DEFAULT_DETECT_INTERVAL_MIN=120

# ── 日志(预留)──
LOG_LEVEL=INFO
